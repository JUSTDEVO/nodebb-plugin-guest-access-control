{
  "id": "nodebb-plugin-guest-access-control",
  "name": "Guest Access Control",
  "description": "Force guests to register before accessing the forum",
  "url": "https://github.com/FORSTLAND/nodebb-plugin-guest-access-control",
  "library": "./library.js",
  "staticDirs": {
    "static": "./static"
  },
  "css": ["static/style.css"],
  "acpScripts": ["static/admin.js"],
  "templates": "./static/templates",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:middleware.render",
      "method": "checkGuestAccess"
    },
    {
      "hook": "filter:admin.header.build",
      "method": "addAdminNavigation"
    }
  ],
  "compatibility": "^4.0.0"
}
